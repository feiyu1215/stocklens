# StockLens 环境变量示例 —— 复制为 .env.local 并填入真实值
# .env.local 已被 .gitignore 排除，严禁提交真实凭据到仓库

# 扶摇金融数据 API Key（登录 https://fuyao.aicubes.cn →「API Key 管理」页签发，请求头 X-api-key）
FUYAO_API_KEY=

# DeepSeek（AI 层，Phase 4 起使用；Task 01 未接入）
DEEPSEEK_API_KEY=
